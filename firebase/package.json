{
  "name": "omycare-firebase-portal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs tests/ui.test.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-omycare --only firestore \"node --test tests/rules.test.mjs\"",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "esbuild": "0.28.2",
    "firebase-tools": "15.31.0",
    "jsdom": "30.1.1"
  }
}
